# Provider secrets stay on the backend. Set exact model IDs available in your account.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODELS=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODELS=
# Product connection URLs are generated in .runtime/product.json by bootstrap_product.py.
PRODUCT_APP_DATABASE_URL=
PRODUCT_QUERY_DATABASE_URL=
PRODUCT_REDIS_URL=redis://127.0.0.1:56379/0
PRODUCT_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false
# Opt-in tracing sends workflow data to your LangSmith account. Review privacy before enabling.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=school-insight
# Optional mounted backup target; default .runtime/backups. Separate storage is required for disaster recovery.
PRODUCT_BACKUP_DIRECTORY=
# HTTPS configuration (Caddy receives these through its own service environment).
SITE_DOMAIN=
SITE_CONTACT_EMAIL=
