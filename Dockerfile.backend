FROM python:3.12-slim-bookworm AS dependencies
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.txt .
# CPU-only Torch avoids downloading multi-gigabyte CUDA libraries on EC2.
RUN pip install torch==2.6.0+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/app/.runtime/models OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false PATH=/opt/venv/bin:$PATH
WORKDIR /app
RUN groupadd --gid 10001 insight && useradd --uid 10001 --gid insight --create-home insight \
    && mkdir -p /app/.runtime && chown insight:insight /app/.runtime
COPY --from=dependencies /opt/venv /opt/venv
COPY product ./product
COPY scripts ./scripts
COPY school_management_postgres92.sql ./
COPY ["School Management Database - User Manual.pdf", "./"]
USER insight
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/api/health',timeout=5)"
CMD ["python", "-m", "uvicorn", "product.api:app", "--host", "0.0.0.0", "--port", "8100", "--no-access-log", "--no-proxy-headers"]
