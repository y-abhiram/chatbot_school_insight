[Unit]
Description=School Insight document and backup worker
After=network-online.target
[Service]
Type=simple
User=jony
WorkingDirectory=/home/jony/Documents/chat
ExecStart=/home/jony/miniconda3/bin/python -m celery -A product.jobs.celery worker --loglevel=warning --pool=solo --concurrency=1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
